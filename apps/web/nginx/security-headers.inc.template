# A7 — security headers cho SPA. Include ở server VÀ mọi location có add_header riêng
# (nginx: add_header trong location GHI ĐÈ toàn bộ header kế thừa từ server).
# Template: envsubst lúc container start (chỉ biến CSP_*). Mặc định ở apps/web/Dockerfile.
#   CSP_HEADER       Content-Security-Policy-Report-Only (mặc định, chỉ báo) | Content-Security-Policy (chặn)
#   CSP_CONNECT_SRC  origin Keycloak (SPA gọi discovery/token endpoint), vd https://sso.example.com
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "no-referrer" always;
# Google Fonts: src/theme/tokens.css @import fonts.googleapis.com → font tải từ fonts.gstatic.com.
add_header ${CSP_HEADER} "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ${CSP_CONNECT_SRC}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
