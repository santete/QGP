# Nginx: phục vụ SPA (React) + reverse-proxy /v1, /auth, /healthz → service 'api' (ADR-0011).
# Prod: bật block HTTPS (443) + chuyển hướng 80→443. Cert mount vào /etc/nginx/certs.
# Template (nginx image): /etc/nginx/templates/*.template → envsubst → /etc/nginx/conf.d/ lúc start.
# Chỉ thay biến CSP_* (NGINX_ENVSUBST_FILTER) → $host/$uri… của nginx giữ nguyên.

# --- HTTP (dev/prod-behind-LB). Prod có TLS: bỏ comment dòng redirect. ---
server {
    listen 80;
    server_name _;
    # return 301 https://$host$request_uri;   # <-- bật khi terminate TLS ở nginx này

    root /usr/share/nginx/html;
    index index.html;

    # A7 — security headers + CSP (env CSP_HEADER / CSP_CONNECT_SRC). HSTS chỉ bật ở block 443.
    include /etc/nginx/conf.d/security-headers.inc;

    # SPA fallback: mọi route không phải file → index.html (React Router).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API REST + auth → backend .NET (service 'api' trong docker network).
    location /v1/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /auth/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /healthz {
        proxy_pass http://api:8080;
    }

    # Cache asset tĩnh có hash (Vite) — an toàn cache dài.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/conf.d/security-headers.inc;   # add_header ở đây ghi đè header của server
    }
}

