{
  "name": "@qgp/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "QGP — Quality Governance Portal (FE, React+Vite+TS, Minimal UI)",
  "scripts": {
    "dev": "vite",
    "dev:real": "vite --mode real",
    "dev:oidc": "vite --mode oidc",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../../product-spec/api/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "dompurify": "^3.1.7",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
