# Real mode — nối qgp-api (.NET) thật, KHÔNG mock. Dùng qua `npm run dev:real` (vite --mode real).
# BE chạy trước: dotnet run --project apps/api/src/Qgp.Api  → http profile launchSettings = :5048
VITE_API_BASE_URL=/v1
# Tắt mock: client.ts + AuthContext gọi BE thật (login qua /auth/dev-login).
VITE_USE_MOCK=0
# Đích proxy Vite → BE. Override nếu BE chạy port khác (vd máy có port conflict :5048):
#   VITE_API_PROXY_TARGET=http://localhost:8085 npm run dev:real
VITE_API_PROXY_TARGET=http://localhost:5048
# KHÔNG set VITE_DEV_TOKEN ở real mode — token thật do login (/auth/dev-login) cấp.
