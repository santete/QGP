# OIDC mode (A1b) — login THẬT qua Keycloak. Dùng: `npm run dev:oidc` (vite --mode oidc).
# Yêu cầu chạy trước:
#   1) docker compose -f deploy/docker-compose.yml up -d keycloak   (realm qgp @ http://localhost:8081)
#   2) BE ở Oidc mode để /v1 chấp nhận token Keycloak:
#      $env:Auth__Mode='Oidc'; $env:Auth__OidcAuthority='http://localhost:8081/realms/qgp';
#      $env:Auth__RequireHttpsMetadata='false'; dotnet run --project apps/api/src/Qgp.Api
# User mẫu (realm-qgp.json): reader1/author1/approver1/qalead1/admin1 — mật khẩu Password123!
VITE_API_BASE_URL=/v1
# Tắt mock API (gọi BE thật).
VITE_USE_MOCK=0
# Bật OIDC: có authority → AuthProvider dùng react-oidc-context (Authorization Code + PKCE).
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/qgp
VITE_OIDC_CLIENT_ID=qgp-web
# Proxy /v1 + /auth sang BE (override nếu BE chạy port khác).
VITE_API_PROXY_TARGET=http://localhost:5048
