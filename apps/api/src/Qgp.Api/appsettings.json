{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Qgp": "Host=localhost;Port=5432;Database=qgp_db;Username=qgp;Password=qgp"
  },
  "Auth": {
    "Mode": "Dev",
    "Issuer": "qgp-dev",
    "Audience": "qgp-api",
    "OidcAuthority": "",
    "RequireHttpsMetadata": true,
    "RoleMap": {
      "reader": "READER",
      "contributor": "CONTRIBUTOR",
      "author": "AUTHOR",
      "approver": "APPROVER",
      "qa_lead": "QA_LEAD",
      "admin": "ADMIN"
    }
  },
  "Scheduler": {
    "IntervalSeconds": 60,
    "ReviewReminderIntervalSeconds": 86400
  },
  "Review": {
    "LeadDaysWarn": 30
  },
  "Meili": {
    "Url": "http://localhost:7700",
    "ApiKey": "qgp_dev_master_key"
  },
  "Git": {
    "RepoPath": "content-repo"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "RateLimit": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 10,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "ServiceName": "qgp-api",
  "ServiceVersion": "1.0.0",
  "Otel": {
    "OtlpEndpoint": "",
    "EnableEntityFramework": true,
    "EnableQuartz": true,
    "EnableRedis": false,
    "EnableMongo": false,
    "EnableMassTransit": false,
    "EnableGrpc": false
  }
}
