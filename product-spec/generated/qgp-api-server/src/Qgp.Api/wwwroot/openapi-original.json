    "description" : "Public REST API cho QGP (qgp-api, .NET 8). Sinh từ SDD-QGP-001 §3, map từ PRD-QGP-001 v1.0. Base path /v1. Auth Bearer (OIDC). Verb unsafe cần header Idempotency-Key. Error code theo ISC Internal Standard — API & Error Code.\n",
    "license" : {
      "name" : "Proprietary — FPT ISC (internal)",
      "url" : "https://internal.fpt/legal"
    },
    "title" : "QGP — Quality Governance Portal API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "description" : "Prod (nội bộ)",
    "url" : "https://qgp.internal.fpt/v1"
  }, {
    "description" : "Staging",
    "url" : "https://staging.qgp.internal.fpt/v1"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "description" : "Quản trị tài liệu & vòng đời",
    "name" : "Documents"
  }, {
    "description" : "Phiên bản, phê duyệt, ban hành, acknowledgement",
    "name" : "Versions"
  }, {
    "description" : "Tra cứu full-text",
    "name" : "Search"
  }, {
    "description" : "Gợi ý tài liệu theo role",
    "name" : "Recommendations"
  }, {
    "description" : "Phản hồi & triage",
    "name" : "Feedback"
  }, {
    "description" : "Báo cáo quản trị (aggregate)",
    "name" : "Reports"
  }, {
    "description" : "Truy vết audit log",
    "name" : "Audit"
  }, {
    "description" : "Trợ lý AI (RAG, P3)",
    "name" : "Assistant"
  } ],
  "paths" : {
    "/documents" : {
