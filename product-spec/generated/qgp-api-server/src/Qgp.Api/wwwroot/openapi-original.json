  "components" : {
    "parameters" : {
      "DocId" : {
        "description" : "vd QA-PROC-005",
        "explode" : false,
        "in" : "path",
        "name" : "doc_id",
        "required" : true,
        "schema" : {
          "type" : "string"
        },
        "style" : "simple"
      },
      "VersionId" : {
        "explode" : false,
        "in" : "path",
        "name" : "id",
        "required" : true,
        "schema" : {
          "format" : "uuid",
          "type" : "string"
        },
        "style" : "simple"
      },
      "IdempotencyKey" : {
        "description" : "Bắt buộc cho verb unsafe (§3.4). Same key+body → cache; khác body → 409.",
        "explode" : false,
        "in" : "header",
        "name" : "Idempotency-Key",
        "required" : true,
        "schema" : {
          "format" : "uuid",
          "type" : "string"
        },
        "style" : "simple"
      },
      "Query" : {
        "description" : "từ khoá tìm kiếm",
        "explode" : true,
        "in" : "query",
        "name" : "q",
        "required" : false,
        "schema" : {
          "type" : "string"
        },
        "style" : "form"
      },
      "FilterType" : {
        "explode" : true,
        "in" : "query",
        "name" : "type",
        "required" : false,
        "schema" : {
          "$ref" : "#/components/schemas/DocumentType"
        },
        "style" : "form"
      },
      "FilterTag" : {
        "explode" : true,
        "in" : "query",
        "name" : "tag",
        "required" : false,
        "schema" : {
          "type" : "string"
        },
        "style" : "form"
      },
      "FilterStatus" : {
        "explode" : true,
        "in" : "query",
        "name" : "status",
        "required" : false,
        "schema" : {
          "$ref" : "#/components/schemas/VersionStatus"
        },
        "style" : "form"
      },
      "Cursor" : {
        "description" : "opaque cursor (§3.5)",
        "explode" : true,
        "in" : "query",
        "name" : "cursor",
        "required" : false,
        "schema" : {
          "type" : "string"
        },
        "style" : "form"
      },
      "Limit" : {
        "explode" : true,
        "in" : "query",
        "name" : "limit",
        "required" : false,
        "schema" : {
          "default" : 50,
          "maximum" : 200,
          "type" : "integer"
        },
        "style" : "form"
      }
    },
    "responses" : {
      "Unauthorized" : {
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Error"
            }
          }
        },
        "description" : "Thiếu/không hợp lệ token"
      },
      "Forbidden" : {
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Error"
            }
          }
        },
        "description" : "Sai role (RBAC §10.1)"
      },
      "NotFound" : {
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Error"
            }
