          "content" : {
            "application/json" : {
              "examples" : {
                "future_effective" : {
                  "summary" : "effective_date tương lai (Approved ≠ Effective)",
                  "value" : {
                    "issue_date" : "2026-07-01",
                    "effective_date" : "2026-07-15",
                    "change_summary" : "Cap nhat tieu chi Quality Gate 1"
                  }
                }
              },
              "schema" : {
                "$ref" : "#/components/schemas/PublishRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PublishResult"
                }
              }
            },
            "description" : "Đã publish"
          },
          "403" : {
            "$ref" : "#/components/responses/Forbidden"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Version đã publish — bất biến (BR-03)"
