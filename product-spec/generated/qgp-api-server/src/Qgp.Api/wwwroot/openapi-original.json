        "summary" : "Submit review (DOC-F-04, UC-01) — Draft → InReview",
        "tags" : [ "Versions" ]
      }
    },
    "/versions/{id}/approve" : {
      "post" : {
        "operationId" : "approveVersion",
        "parameters" : [ {
          "$ref" : "#/components/parameters/VersionId"
        }, {
          "$ref" : "#/components/parameters/IdempotencyKey"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/approveVersion_request"
