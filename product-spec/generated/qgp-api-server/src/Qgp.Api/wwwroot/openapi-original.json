          "404" : {
            "$ref" : "#/components/responses/NotFound"
          }
        },
        "summary" : "Lấy bản Effective + badge trạng thái (DOC-F-12, UC-07/08)",
        "tags" : [ "Documents" ]
      }
    },
    "/documents/{doc_id}/versions" : {
