          "in" : "query",
          "name" : "from",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "form"
        }, {
          "description" : "version đích (vd 2.1)",
          "explode" : true,
          "in" : "query",
          "name" : "to",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "form"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/getDiff_200_response"
                }
              }
            },
            "description" : "Kết quả diff"
          },
          "400" : {
            "$ref" : "#/components/responses/DefaultError"
          }
        },
        "summary" : "Diff giữa 2 version (DOC-F-06)",
        "tags" : [ "Versions" ]
      }
    },
    "/versions/{id}/submit" : {
      "post" : {
        "operationId" : "submitVersion",
