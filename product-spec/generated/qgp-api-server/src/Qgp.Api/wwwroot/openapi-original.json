          "403" : {
            "$ref" : "#/components/responses/Forbidden"
          }
        },
        "summary" : "Tạo revision minor/major (DOC-F-02, UC-05/06)",
        "tags" : [ "Versions" ]
      }
    },
    "/documents/{doc_id}/diff" : {
      "get" : {
        "operationId" : "getDiff",
