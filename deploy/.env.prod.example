# QGP prod env — COPY sang deploy/.env.prod rồi điền giá trị thật. KHÔNG commit .env.prod (chứa secret).
# Dùng: docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod up -d --build
#
# Secret DB/Meili của app KHÔNG nằm ở đây mà ở Docker secrets: deploy/secrets/{POSTGRES_PASSWORD,
# QGP_DB_CONNECTION,QGP_MEILI_KEY} (xem deploy/SECRETS.md). Đổi thư mục: QGP_SECRETS_DIR=/đường/dẫn.

# --- Postgres (mật khẩu: deploy/secrets/POSTGRES_PASSWORD) ---
POSTGRES_USER=qgp
POSTGRES_DB=qgp_db

# --- Meilisearch (master key >= 16 bytes) ---
# Container Meili không đọc được *_FILE → key vẫn ở env; PHẢI trùng deploy/secrets/QGP_MEILI_KEY.
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key

# --- Keycloak (IdP) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin
KEYCLOAK_PORT=8081
# URL công khai của Keycloak (trình duyệt truy cập) — TLS terminate ở proxy/LB phía trước.
KC_HOSTNAME=https://sso.example.com
# DB riêng cho Keycloak trên cùng Postgres (init script tạo khi volume trống).
# KC_DB_PASSWORD nằm ở env vì Keycloak không hỗ trợ đọc *_FILE (xem SECRETS.md).
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME_keycloak_db
# Origin FE → redirect URI / web origin của client qgp-web trong realm prod.
QGP_WEB_ORIGIN=https://qgp.example.com

# --- OIDC (BE validate + FE redirect). AUTHORITY là URL realm mà TRÌNH DUYỆT truy cập được. ---
# Prod: https://sso.example.com/realms/qgp  (đặt OIDC_REQUIRE_HTTPS=true)
# Staging http nội bộ: http://localhost:8081/realms/qgp  (OIDC_REQUIRE_HTTPS=false)
OIDC_AUTHORITY=https://sso.example.com/realms/qgp
OIDC_REQUIRE_HTTPS=true
OIDC_AUDIENCE=qgp-api
OIDC_CLIENT_ID=qgp-web

# --- CORS: origin FE thật (csv nếu nhiều). PHẢI khớp domain người dùng mở app ---
CORS_ALLOWED_ORIGINS=https://qgp.example.com

# --- Web (nginx) ports ---
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# CSP: Report-Only (chỉ báo) khi mới go-live; không còn vi phạm → Content-Security-Policy (chặn).
# connect-src lấy từ KC_HOSTNAME.
CSP_HEADER=Content-Security-Policy-Report-Only

# --- Observability (ISC.Observability → OTLP collector). Rỗng = tắt. ---
OTEL_OTLP_ENDPOINT=http://otel-collector:4317

# --- Stack observability riêng (deploy/observability/docker-compose.yml) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin
GRAFANA_PORT=3000                     # chỉ bind 127.0.0.1
QGP_APP_NETWORK=qgp-prod_default      # network của app stack (project 'qgp-prod')
PROMETHEUS_RETENTION=15d
